{
  "name": "crustini-syntax",
  "displayName": "Crustini Syntax",
  "description": "Syntax highlighting for Crustini .flour files.",
  "version": "0.0.1",
  "publisher": "crustini",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "crs",
        "aliases": [
          "Crustini",
          "flour",
          "crs"
        ],
        "extensions": [
          ".flour",
          ".crs",
          ".crst"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crs",
        "scopeName": "source.crs",
        "path": "./syntaxes/crs.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "crs",
        "path": "./snippets/crs.code-snippets"
      }
    ]
  }
}
