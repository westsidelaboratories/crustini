{
  "Crustini sketch": {
    "prefix": "sketch",
    "body": [
      "+++",
      "crustini = \"0.1\"",
      "name = \"${1:Sketch}\"",
      "fps = 30",
      "window = [640, 360]",
      "+++",
      "",
      "app! Main {",
      "  state {",
      "    x: number = 40;",
      "  }",
      "",
      "  fn draw() {",
      "    clear(Color::Black);",
      "    x += 2;",
      "    circle(x, 180, 24, Color::White);",
      "  }",
      "}"
    ],
    "description": "Processing-style Crustini sketch"
  },
  "Crustini app": {
    "prefix": "app",
    "body": [
      "+++",
      "crustini = \"0.1\"",
      "name = \"${1:App}\"",
      "fps = 30",
      "window = [640, 360]",
      "+++",
      "",
      "app! Main {",
      "  state {",
      "    x: number = 40;",
      "    speed: number = 120;",
      "  }",
      "",
      "  fn update() {",
      "    x += axis_x() * speed * dt();",
      "  }",
      "",
      "  fn draw() {",
      "    clear(Color::Black);",
      "    rect(x, 100, 24, 24, Color::White);",
      "  }",
      "}"
    ],
    "description": "Structured Crustini update/draw app"
  }
}
