{
  "scopeName": "source.crs",
  "name": "Crustini",
  "fileTypes": [
    "crs"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#macro"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.crs",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.crs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.crs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "macro": {
      "patterns": [
        {
          "name": "entity.name.function.macro.crs",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*!"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.crs",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:ms|%)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.declaration.crs",
          "match": "\\b(?:app|name|target|display|input|button|state|screen|fps|setup|update|draw|on|every|const|goto)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.crs",
          "match": "\\b(?:if|else|match|let|mut|return|break|continue|for|while|in|use|as)\\b"
        },
        {
          "name": "constant.language.boolean.crs",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.crs",
          "match": "\\b(?:u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|bool|str|char|f32|f64|rgb565|rgb888|mono)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.other.crs",
          "match": "\\b(?:BLACK|WHITE|GRAY|GREEN|RED|BLUE|YELLOW|MAGENTA|CYAN|ON|OFF|bold_12|bold_16|big|small|landscape|portrait|esp32_s3|rp2040|stm32|st7789|ssd1306|sh1106|ili9341)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.crs",
          "match": "\\b(?:clear|pixel|line|rect|fill_rect|circle|text|bitmap|sprite|flush|progress|menu|card|meter|toggle|slider|redraw|min|max|clamp)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.crs",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.crs",
          "match": "[=+\\-*/%<>!|&]+"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.crs",
          "match": "[{}\\[\\](),:.]"
        }
      ]
    }
  }
}
