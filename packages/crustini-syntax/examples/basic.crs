+++
crustini = "0.1"
name = "Mode Demo"
fps = 30
window = [640, 360]
+++

enum Mode {
  Title,
  Playing,
}

app! Main {
  state {
    mode: Mode = Mode::Title;
    x: number = 40;
    speed: number = 120;
  }

  fn update() {
    if pressed(Button::A) {
      mode = Mode::Playing;
    }

    if mode == Mode::Playing {
      x += axis_x() * speed * dt();
    }
  }

  fn draw() {
    clear(Color::Black);

    match mode {
      Mode::Title => {
        text(40, 40, "PRESS A", Color::White);
      }

      Mode::Playing => {
        circle(x, 180, 24, Color::White);
      }
    }
  }
}
