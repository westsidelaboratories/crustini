{
  "name": "@crustini/syntax",
  "version": "0.0.1",
  "description": "Permanent syntax highlighting kit for Crustini .flour files.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/html.ts",
    "./tokenizer": "./src/crs-tokenizer.ts",
    "./codemirror": "./src/codemirror.ts",
    "./prism": "./src/prism.ts",
    "./highlightjs": "./src/highlightjs.ts",
    "./dist": "./dist/crustini-highlight.js",
    "./theme": "./themes/crustini-dark.css",
    "./grammar": "./grammars/crs.tmLanguage.json"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "highlight.js": "^11.0.0",
    "prismjs": "^1.29.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    }
  },
  "files": [
    "src",
    "dist",
    "grammars",
    "themes",
    "vscode-extension",
    "README.md"
  ],
  "license": "MIT"
}
