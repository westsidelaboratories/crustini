{
  "scopeName": "source.flour",
  "name": "Crustini",
  "fileTypes": [
    "flour",
    "crst"
  ],
  "patterns": [
    { "include": "#frontMatter" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#compilerForm" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#paths" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#properties" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "frontMatter": {
      "patterns": [
        {
          "name": "punctuation.definition.frontmatter.crs",
          "match": "^\\+\\+\\+$"
        },
        {
          "name": "variable.other.property.toml.crs",
          "match": "\\b(?:crustini|name|fps|window|code)\\b(?=\\s*=)"
        },
        {
          "name": "entity.name.section.toml.crs",
          "match": "^\\s*\\[[A-Za-z_][A-Za-z0-9_]*\\]\\s*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.crs",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.crs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.crs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "compilerForm": {
      "patterns": [
        {
          "name": "entity.name.function.compiler-form.crs",
          "match": "\\bapp!"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.crs",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.declaration.crs",
          "match": "\\b(?:state|fn|struct|enum|setup|update|draw)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.crs",
          "match": "\\b(?:if|else|match|let|mut|return|break|continue|for|while|in)\\b"
        },
        {
          "name": "constant.language.boolean.crs",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.crs",
          "match": "\\b(?:number|text|bool|Vec2|Color|Button|Sprite)\\b"
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "name": "constant.other.path.crs",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=::)"
        },
        {
          "name": "constant.other.variant.crs",
          "match": "(?<=::)[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.other.crs",
          "match": "\\b(?:Black|White|Gray|Green|Red|Blue|Yellow|Magenta|Cyan|A|B|Left|Right|Up|Down|Start|Select|Title|Playing|Dead)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.crs",
          "match": "\\b(?:clear|line|rect|circle|text|sprite|vec2|pressed|down|released|axis_x|axis_y|stick|mouse_x|mouse_y|mouse_down|dt|min|max|clamp|abs|hit_rect)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.crs",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*[:=])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.crs",
          "match": "(?:==|!=|<=|>=|&&|\\|\\||\\+=|-=|->|=>|[=+\\-*/%<>!&|])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.crs",
          "match": "(?:::|[{}\\[\\](),:.])"
        }
      ]
    }
  }
}
