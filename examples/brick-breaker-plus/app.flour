app! {
  screen!(320, 240)
  fps!(50)

  state! {
    paddle_x: i16 = 132
    ball_x: i16 = 160
    ball_y: i16 = 188
    ball_vx: i16 = 2
    ball_vy: i16 = -2
    mode: i16 = 0
    lives: i16 = 3
    score: u32 = 0
    flash: i16 = 0
    b01: bool = true
    b02: bool = true
    b03: bool = true
    b04: bool = true
    b05: bool = true
    b06: bool = true
    b07: bool = true
    b08: bool = true
    b09: bool = true
    b10: bool = true
    b11: bool = true
    b12: bool = true
    b13: bool = true
    b14: bool = true
    b15: bool = true
    b16: bool = true
    b17: bool = true
    b18: bool = true
  }

  update! {
    if left {
      paddle_x = paddle_x - 5
    }

    if right {
      paddle_x = paddle_x + 5
    }

    if mouse_down {
      paddle_x = mouse_x - 26
    }

    paddle_x = clamp!(paddle_x, 8, 260)

    if flash > 0 {
      flash = flash - 1
    }

    if mode == 0 {
      ball_x = paddle_x + 26
      ball_y = 188

      if mouse_down {
        mode = 1
      }

      if start {
        mode = 1
      }

      if a {
        mode = 1
      }
    }

    if mode == 1 {
      ball_x = ball_x + ball_vx
      ball_y = ball_y + ball_vy

      if ball_x < 7 {
        ball_x = 7
        ball_vx = abs!(ball_vx)
      }

      if ball_x > 313 {
        ball_x = 313
        ball_vx = 0 - abs!(ball_vx)
      }

      if ball_y < 26 {
        ball_y = 26
        ball_vy = abs!(ball_vy)
      }

      if hit_rect!(ball_x - 3, ball_y - 3, 6, 6, paddle_x, 202, 52, 7) {
        ball_vy = 0 - abs!(ball_vy)

        if ball_x < paddle_x + 16 {
          ball_vx = -3
        }

        if ball_x > paddle_x + 36 {
          ball_vx = 3
        }
      }

      if b01 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 20, 42, 34, 12) {
        b01 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b02 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 58, 42, 34, 12) {
        b02 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b03 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 96, 42, 34, 12) {
        b03 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b04 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 134, 42, 34, 12) {
        b04 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b05 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 172, 42, 34, 12) {
        b05 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b06 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 210, 42, 34, 12) {
        b06 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b07 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 248, 42, 34, 12) {
        b07 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b08 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 39, 60, 34, 12) {
        b08 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b09 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 77, 60, 34, 12) {
        b09 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b10 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 115, 60, 34, 12) {
        b10 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b11 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 153, 60, 34, 12) {
        b11 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b12 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 191, 60, 34, 12) {
        b12 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b13 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 229, 60, 34, 12) {
        b13 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b14 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 20, 78, 34, 12) {
        b14 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b15 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 58, 78, 34, 12) {
        b15 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b16 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 96, 78, 34, 12) {
        b16 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b17 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 134, 78, 34, 12) {
        b17 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if b18 && hit_rect!(ball_x - 3, ball_y - 3, 6, 6, 172, 78, 34, 12) {
        b18 = false
        ball_vy = abs!(ball_vy)
        score = score + 1
        flash = 4
      }

      if score >= 18 {
        mode = 2
      }

      if ball_y > 236 {
        lives = lives - 1
        flash = 10
        mode = 0
        ball_vx = -2
        ball_vy = -2
      }

      if lives <= 0 {
        mode = 3
      }
    }

    if mode == 2 {
      if mouse_down {
        mode = 0
        lives = 3
        score = 0
        b01 = true
        b02 = true
        b03 = true
        b04 = true
        b05 = true
        b06 = true
        b07 = true
        b08 = true
        b09 = true
        b10 = true
        b11 = true
        b12 = true
        b13 = true
        b14 = true
        b15 = true
        b16 = true
        b17 = true
        b18 = true
      }
    }

    if mode == 3 {
      if mouse_down {
        mode = 0
        lives = 3
        score = 0
        b01 = true
        b02 = true
        b03 = true
        b04 = true
        b05 = true
        b06 = true
        b07 = true
        b08 = true
        b09 = true
        b10 = true
        b11 = true
        b12 = true
        b13 = true
        b14 = true
        b15 = true
        b16 = true
        b17 = true
        b18 = true
      }
    }
  }

  draw! {
    clear!(4)
    rect!(0, 0, 320, 24, 16)
    text!(10, 8, "BRICK BREAKER PLUS", 245)
    line!(0, 25, 319, 25, 72)

    if lives >= 1 {
      rect!(266, 8, 8, 8, 210)
    }

    if lives >= 2 {
      rect!(280, 8, 8, 8, 210)
    }

    if lives >= 3 {
      rect!(294, 8, 8, 8, 210)
    }

    if flash > 0 {
      line!(0, 28, 319, 28, 210)
      line!(0, 30, 319, 30, 120)
    }

    line!(8, 30, 8, 230, 48)
    line!(311, 30, 311, 230, 48)
    line!(8, 230, 311, 230, 34)

    if b01 {
      rect!(20, 42, 34, 12, 230)
    }

    if b02 {
      rect!(58, 42, 34, 12, 214)
    }

    if b03 {
      rect!(96, 42, 34, 12, 198)
    }

    if b04 {
      rect!(134, 42, 34, 12, 230)
    }

    if b05 {
      rect!(172, 42, 34, 12, 214)
    }

    if b06 {
      rect!(210, 42, 34, 12, 198)
    }

    if b07 {
      rect!(248, 42, 34, 12, 230)
    }

    if b08 {
      rect!(39, 60, 34, 12, 180)
    }

    if b09 {
      rect!(77, 60, 34, 12, 164)
    }

    if b10 {
      rect!(115, 60, 34, 12, 148)
    }

    if b11 {
      rect!(153, 60, 34, 12, 180)
    }

    if b12 {
      rect!(191, 60, 34, 12, 164)
    }

    if b13 {
      rect!(229, 60, 34, 12, 148)
    }

    if b14 {
      rect!(20, 78, 34, 12, 132)
    }

    if b15 {
      rect!(58, 78, 34, 12, 118)
    }

    if b16 {
      rect!(96, 78, 34, 12, 104)
    }

    if b17 {
      rect!(134, 78, 34, 12, 132)
    }

    if b18 {
      rect!(172, 78, 34, 12, 118)
    }

    rect!(paddle_x, 202, 52, 7, 245)
    rect!(paddle_x + 6, 199, 40, 3, 130)
    circle!(ball_x, ball_y, 4, 255)

    if mode == 0 {
      text!(82, 132, "CLICK START OR A", 210)
      text!(86, 146, "ARROWS OR MOUSE", 130)
    }

    if mode == 2 {
      text!(112, 132, "BOARD CLEARED", 255)
      text!(100, 146, "CLICK TO REPLAY", 180)
    }

    if mode == 3 {
      text!(126, 132, "GAME OVER", 255)
      text!(102, 146, "CLICK TO RETRY", 180)
    }

    if score >= 6 {
      text!(20, 216, "NICE", 86)
    }

    if score >= 12 {
      text!(58, 216, "KEEP GOING", 120)
    }
  }
}
