+++
crustini = "0.1"
name = "Mouse Follow"
fps = 30
window = [220, 140]
+++

app! Main {
  state {
    x: number = 110;
    y: number = 70;
    shade: Color = 150;
    size: number = 10;
  }

  fn update() {
    x = mouse_x();
    y = mouse_y();
    shade = 150;
    size = 10;

    if mouse_down() {
      shade = Color::White;
      size = 16;
    }

    if y < 1 {
      y = 70;
    }
  }

  fn draw() {
    clear(Color::Black);
    line(0, y, 220, y, 50);
    line(x, 0, x, 140, 50);
    circle(x, y, size, shade);
    rect(x - 2, y - 2, 4, 4, Color::Black);
    text(18, 18, "MOUSE FOLLOW", 210);
  }
}
