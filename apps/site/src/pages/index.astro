---
import { renderCrsBlock } from "@crustini/syntax";
import "../styles/global.css";

const example = `app! {
  screen 240 135
  fps 30

  state {
    x: i16 = 120
    y: i16 = 67
    vx: i16 = 1
  }

  setup {
    clear 0
  }

  update {
    x = x + vx

    if x > 232 {
      vx = -1
    }

    if x < 8 {
      vx = 1
    }
  }

  draw {
    clear 12
    circle x y 8 255
  }
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Crustini is a tiny app syntax that bakes into no_std Rust." />
    <title>Crustini</title>
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="/">Crustini</a>
        <nav class="nav" aria-label="Main">
          <a href="#build">Build</a>
          <a href="#workspace">Workspace</a>
          <a href="/live/">Docs Live</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="shell hero-grid">
          <div>
            <h1>Crustini</h1>
            <p class="lede">Tiny <code>.flour</code> app syntax that bakes into boring <code>#![no_std]</code> Rust for small-device UI experiments.</p>
            <div class="actions">
              <a class="button primary" href="#build">Build the example</a>
              <a class="button" href="/live/">Open Docs Live</a>
            </div>
          </div>

          <div class="code-frame" aria-label="Crustini source example">
            <div class="code-label">
              <span>examples/bounce/app.flour</span>
              <span>.flour</span>
            </div>
            <Fragment set:html={renderCrsBlock(example)} />
          </div>
        </div>
      </section>

      <section id="build" class="section">
        <div class="shell">
          <h2>Build</h2>
          <p>A bake emits a generated Rust crate into the oven, then Cargo builds that crate against <code>crustini-core</code>. The current oven directory is <code>.oven/</code>, with <code>build</code> kept as a compatibility alias.</p>
          <div class="commands" aria-label="Build commands">
            <code>cargo run -p crustini -- starter counter my-counter</code>
            <code>cargo run -p crustini -- bake my-counter/app.flour</code>
            <code>cargo run -p crustini -- emit examples/bounce/app.crst</code>
          </div>
        </div>
      </section>

      <section id="workspace" class="section">
        <div class="shell">
          <h2>Workspace</h2>
          <div class="grid">
            <article class="tile">
              <h3>Rust crates</h3>
              <p><code>crates/crustini</code> contains the host compiler and CLI. <code>crates/crustini-core</code> contains the no_std runtime surface.</p>
            </article>
            <article class="tile">
              <h3>Shared packages</h3>
              <p><code>packages/crustini-syntax</code> provides tokenizer, HTML, Prism, Highlight.js, CodeMirror, grammar, and theme assets.</p>
            </article>
            <article class="tile">
              <h3>Apps</h3>
              <p><code>apps/site</code> is the Astro site. Examples remain in <code>examples/</code> as source fixtures for the compiler.</p>
            </article>
            <article class="tile">
              <h3>Vocabulary</h3>
              <p><code>.flour</code> source is baked in an oven to produce a loaf. Crumbs are diagnostics and logs. Starters are project templates.</p>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell">MIT licensed. Version 0.0.1.</div>
    </footer>
  </body>
</html>
