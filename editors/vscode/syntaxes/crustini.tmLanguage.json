{
  "scopeName": "source.crustini",
  "name": "Crustini",
  "patterns": [
    { "include": "#frontMatter" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#compilerForm" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#paths" },
    { "include": "#builtins" },
    { "include": "#properties" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "frontMatter": {
      "patterns": [
        { "name": "punctuation.definition.frontmatter.crustini", "match": "^\\+\\+\\+$" },
        { "name": "variable.other.property.toml.crustini", "match": "\\b(?:crustini|name|fps|window|code)\\b(?=\\s*=)" },
        { "name": "entity.name.section.toml.crustini", "match": "^\\s*\\[[A-Za-z_][A-Za-z0-9_]*\\]\\s*$" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.crustini", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.crustini",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.crustini", "match": "\\\\." }
          ]
        }
      ]
    },
    "compilerForm": {
      "patterns": [
        { "name": "entity.name.function.compiler-form.crustini", "match": "\\bapp!" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.crustini", "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        { "name": "storage.type.declaration.crustini", "match": "\\b(?:state|fn|struct|enum|setup|update|draw)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.crustini", "match": "\\b(?:if|else|match|let|mut|return|break|continue|for|while|in)\\b" },
        { "name": "constant.language.boolean.crustini", "match": "\\b(?:true|false)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.crustini", "match": "\\b(?:number|text|bool|Vec2|Color|Button|Sprite)\\b" }
      ]
    },
    "paths": {
      "patterns": [
        { "name": "constant.other.path.crustini", "match": "\\b[A-Z][A-Za-z0-9_]*(?=::)" },
        { "name": "constant.other.variant.crustini", "match": "(?<=::)[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.builtin.crustini", "match": "\\b(?:clear|line|rect|circle|text|sprite|vec2|pressed|down|released|axis_x|axis_y|stick|mouse_x|mouse_y|mouse_down|dt|min|max|clamp|abs|hit_rect)\\b" }
      ]
    },
    "properties": {
      "patterns": [
        { "name": "variable.other.property.crustini", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*[:=])" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.crustini", "match": "(?:==|!=|<=|>=|&&|\\|\\||\\+=|-=|->|=>|[=+\\-*/%<>!&|])" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.crustini", "match": "(?:::|[{}\\[\\](),:.])" }
      ]
    }
  }
}
